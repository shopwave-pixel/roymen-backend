# ROYMEN Backend - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_jwt_secret_key_here_min_32_chars_recommended

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Optional: If not set, uses local JSON fallback (data/db.json)
# For production with MongoDB Atlas:
MONGODB_URI=

# ============================================
# CLOUDINARY IMAGE UPLOAD
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# EMAIL SERVICE (SMTP)
# ============================================
# For Gmail: use App Password, not regular password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=ROYMEN
SMTP_FROM_EMAIL=noreply@roymen.com

# ============================================
# FRONTEND URL
# ============================================
# Used for links in emails and CORS
APP_URL=http://localhost:3000


